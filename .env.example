# Copia a .env con "make init". Nunca subas .env al repositorio.
# Los comentarios van en su propia linea (no al final del valor).

# --- Postgres ---
POSTGRES_USER=app
# Solo letras y numeros: se interpola dentro de DATABASE_URL.
POSTGRES_PASSWORD=devonlychangeme
POSTGRES_DB=eightd

# --- Autenticacion ---
# Login de demo (elegir usuario precargado, sin contrasena). false fuera de la demo.
DEMO_LOGIN=true
SESSION_TTL_HOURS=10
# true solo detras de HTTPS
COOKIE_SECURE=false
# Origenes permitidos para POST/PUT/PATCH/DELETE (defensa CSRF), separados por coma
ALLOWED_ORIGINS=http://localhost:3000

# --- Modelos de lenguaje ---
# Dos destinos, los dos hablan el protocolo de OpenAI. El router decide a cual va cada llamada:
#   LOCAL = contexto confidencial (debe ser un host de la red privada: ollama, vllm, 10.x, *.internal...).
#   API   = contexto publico/interno ya redactado (p. ej. OpenRouter). Sin LLM_API__*, todo va a local.
# Los modelos van fijos (no "el mas barato") para que los evals sean reproducibles.
# El esquema es DESTINO + "__" + CAMPO, en mayusculas. Sin comillas ni comentarios al final.
#
# Ejemplo de planta (local de verdad):
#   LLM_LOCAL__BASE_URL=http://ollama:11434/v1
#   LLM_LOCAL__PROVIDER_LABEL=ollama-planta
#   LLM_LOCAL__MODEL_SMALL=<modelo>
#   LLM_LOCAL__MODEL_LARGE=<modelo>
#
# PRUEBA CON OPENROUTER PARA AMBOS DESTINOS (solo con datos ficticios, como el dataset de demo):
# el "local" se simula con OpenRouter. Queda en audit_log con su etiqueta y rompe la garantia de
# que lo confidencial no sale de la planta; nunca en produccion.
LLM_ALLOW_SIMULATED_LOCAL=true
LLM_LOCAL__SIMULATED=true
LLM_LOCAL__BASE_URL=https://openrouter.ai/api/v1
LLM_LOCAL__API_KEY=
LLM_LOCAL__PROVIDER_LABEL=openrouter-simula-local
LLM_LOCAL__MODEL_SMALL=
LLM_LOCAL__MODEL_LARGE=
# Los prompts de D4 son largos y los modelos grandes tardan: el valor por defecto (60 s) se queda corto.
LLM_LOCAL__TIMEOUT_S=180
# USD por millon de tokens, de la pagina del modelo en OpenRouter (para el costo del audit_log).
LLM_LOCAL__PRICE_IN_PER_MTOK=0.66
LLM_LOCAL__PRICE_OUT_PER_MTOK=1.98
# JSON en una sola linea. data_collection=deny excluye a proveedores que entrenan con tus datos.
LLM_LOCAL__EXTRA_BODY={"provider":{"data_collection":"deny"}}

LLM_API__BASE_URL=https://openrouter.ai/api/v1
LLM_API__API_KEY=
LLM_API__PROVIDER_LABEL=openrouter
LLM_API__MODEL_SMALL=
LLM_API__MODEL_LARGE=
LLM_API__TIMEOUT_S=120
LLM_API__PRICE_IN_PER_MTOK=2
LLM_API__PRICE_OUT_PER_MTOK=10
LLM_API__EXTRA_BODY={"provider":{"data_collection":"deny"}}
# Pon true solo si el servidor acepta response_format=json_object; la salida se valida igual.
# Con false el esquema va en el prompt, que funciona con cualquier modelo.
LLM_LOCAL__JSON_MODE=false
LLM_API__JSON_MODE=false

# USAR OPENAI EN VEZ DE OPENROUTER (en LOCAL simulado, en API o en ambos; la llave va en cada destino):
#   LLM_<DESTINO>__BASE_URL=https://api.openai.com/v1
#   LLM_<DESTINO>__API_KEY=<llave de OpenAI>
#   LLM_<DESTINO>__PROVIDER_LABEL=openai
#   LLM_<DESTINO>__MODEL_SMALL=<modelo>   y   LLM_<DESTINO>__MODEL_LARGE=<modelo>
#   LLM_<DESTINO>__PRICE_IN_PER_MTOK / __PRICE_OUT_PER_MTOK = precios de la pagina de OpenAI
#       (OpenAI no devuelve el costo en la respuesta: el audit_log lo estima con estos precios)
#   LLM_<DESTINO>__EXTRA_BODY={}   <- obligatorio: "provider" es de OpenRouter y OpenAI responde 400 si lo recibe
# Solo si el modelo es de razonamiento (o-series, GPT-5), que rechaza max_tokens y temperature:
#   LLM_<DESTINO>__TOKEN_PARAM=max_completion_tokens
#   LLM_<DESTINO>__SEND_TEMPERATURE=false
# Con esos modelos el tope de tokens incluye el razonamiento: si la respuesta llega vacia
# (finish_reason=length), sube el tope o usa un modelo sin razonamiento.

# --- Embeddings (siempre locales) ---
# Valores: fastembed | ollama. Cambiar de proveedor exige reindexar.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Debe coincidir con la columna vector(N) de la migracion (0005: vector(1024)).
EMBEDDING_DIM=1024

# --- Trazas ---
# json: archivos en TRACE_DIR, sin dependencias (por defecto).
# langfuse: exporta a Langfuse; requiere "make observability".
TRACE_EXPORTER=json
TRACE_DIR=/workspace/traces

# Llaves del proyecto de Langfuse. Las usa la API para enviar trazas y Langfuse
# para crear el proyecto al primer arranque. "make init-langfuse" las reemplaza
# por valores aleatorios la primera vez.
LANGFUSE_PORT=3001
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
