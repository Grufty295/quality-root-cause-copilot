# Pestaña "Environment" del servicio en Dokploy. NO subas este archivo con valores reales.
#
# Genera cada secreto con:   openssl rand -hex 32
# Usa hex (no base64): los caracteres / + = rompen la DATABASE_URL de Postgres.

# --- Dominio público (el mismo que agregas en la pestaña Domains), con https ---
NEXTAUTH_URL=

# --- Secretos de la aplicación ---
NEXTAUTH_SECRET=
SALT=
# ENCRYPTION_KEY: 64 caracteres hex (256 bits). Si la pierdes, los datos cifrados no se recuperan.
ENCRYPTION_KEY=

# --- Postgres ---
POSTGRES_USER=langfuse
POSTGRES_DB=langfuse
POSTGRES_PASSWORD=

# --- ClickHouse ---
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=

# --- Redis ---
REDIS_AUTH=

# --- Cloudflare R2 ---
# Account ID: dashboard de Cloudflare > R2 > Overview.
R2_ACCOUNT_ID=
R2_BUCKET=langfuse
# Token de API de R2 con permiso Object Read & Write limitado a ese bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
