# Plantilla LOCAL de Langfuse (make observability). Lo copia `make init-langfuse`
# a .env.langfuse y sustituye cada CHANGEME_* por un secreto aleatorio.
# No pongas valores reales aquí. .env.langfuse está en .gitignore.
#
# Para Dokploy usa .env.langfuse.dokploy.example (otra plantilla, sin CHANGEME_*).

NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=CHANGEME_NEXTAUTH
SALT=CHANGEME_SALT
# 64 caracteres hex. Si la pierdes, los datos cifrados no se recuperan.
ENCRYPTION_KEY=CHANGEME_ENCRYPTION

POSTGRES_USER=langfuse
POSTGRES_DB=langfuse
POSTGRES_PASSWORD=CHANGEME_PG

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME_CLICKHOUSE

REDIS_AUTH=CHANGEME_REDIS

# MinIO (almacenamiento S3 local). Las llaves S3 deben coincidir con las de MinIO.
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=CHANGEME_MINIO
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGEME_MINIO
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGEME_MINIO

# Contraseña del usuario admin@example.com en la UI de Langfuse (http://localhost:3001).
LANGFUSE_INIT_USER_PASSWORD=CHANGEME_ADMIN
